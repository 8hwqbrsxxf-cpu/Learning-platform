# Claude API key for the AI Study Coach (https://console.anthropic.com). Optional.
ANTHROPIC_API_KEY=

# The coach looks up facts live in Microsoft Learn via the public Microsoft Learn MCP server
# (https://learn.microsoft.com/api/mcp, no account needed). Set to "off" to disable.
# LEARN_MCP=on

# Password gate (HTTP Basic Auth) for all pages. Strongly recommended when the app
# is reachable from outside your home network. Leave empty to disable.
APP_USER=admin
APP_PASSWORD=

# Location of the SQLite progress database (Docker default: /data/learning.db)
# DATABASE_PATH=./data/learning.db
